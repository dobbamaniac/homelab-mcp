# Absolute path to the one project directory Peek may read
#
# Linux/macOS example:
# PATH=/home/alice/Projects/coding
#
# Windows Docker Desktop example:
# PATH=C:/Users/Alice/projects/coding
PROJECT_PATH=/home/alice/Projects/coding

# Pinned official tunnel-client source tag.
TUNNEL_CLIENT_VERSION=v0.0.10

# Tunnel ID and API key
PEEK_TUNNEL_ID=tunnel_id
PEEK_CONTROL_PLANE_API_KEY=sk-key-here
