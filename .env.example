# Absolute path to the project directory for Peek

# Linux/macOS example:
# PEEK_PROJECT_PATH=/home/alice/Projects/coding

# Windows Docker Desktop example:
# PEEK_PROJECT_PATH=C:/Users/Alice/Projects/coding
PEEK_PROJECT_PATH=/absolute/path/to/project


# Pinned official tunnel-client source tag.
TUNNEL_CLIENT_VERSION=v0.0.10

# Tunnel ID and API key
PEEK_TUNNEL_ID=tunnel_replace_me
PEEK_CONTROL_PLANE_API_KEY=sk-your-key-here
