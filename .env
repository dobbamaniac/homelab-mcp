# Absolute path to the project ChatGPT may inspect.

# Linux/macOS example:
# PROJECT_ROOT=/home/alice/Projects/coding

# Windows with Docker Desktop:
# PROJECT_ROOT=C:/Users/Alice/Projects/coding
PROJECT_ROOT=/home/rneal/Projects/parable

# Host port exposed only on loopback.
MCP_PORT=8765

# Maximum individual file size returned by read_file, in bytes.
MAX_FILE_BYTES=262144

# Maximum number of text-search matches returned in one request.
MAX_SEARCH_RESULTS=100

# Comma-separated directory names excluded from traversal and search.
IGNORED_DIRECTORIES=.git,.hg,.svn,node_modules,.venv,venv,__pycache__,dist,build,target

# Comma-separated filename patterns excluded from reading and search.
# These are matched against both the basename and repository-relative path.
IGNORED_PATTERNS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,id_rsa,id_ed25519,credentials.json
